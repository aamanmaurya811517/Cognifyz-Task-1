
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cognifyz Registration</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <main class="page">

        <!-- LEFT PANEL -->
        <section class="welcome-panel">

            <% if (registered) { %>

                <div class="success-icon">&#10003;</div>

                <h1 class="success-heading">
                    Registration Successful!
                </h1>

                <p class="success-welcome">
                    Hi <strong><%= name %></strong>, welcome aboard!
                </p>

                <p class="success-description">
                    Your registration has been completed successfully.
                    We're happy to have you here!
                </p>

                <div class="user-details">
                    <p><strong>Name:</strong> <%= name %></p>
                    <p><strong>Email:</strong> <%= email %></p>
                </div>

                <div class="social-text">
                    WELCOME TO OUR COMMUNITY
                </div>

                <a class="back-link" href="/">
                    Register Another User
                </a>

            <% } else { %>

                <div class="moon">&#9790;</div>

                <h1>Welcome Page</h1>

                <p class="welcome-text">
                    Start your journey with us.
                </p>

                <p class="welcome-description">
                    Register today and get a warm welcome!
                </p>

                <div class="social-text">
                    YOUR JOURNEY STARTS HERE
                </div>

            <% } %>

        </section>

        <!-- RIGHT PANEL -->
        <section class="form-panel">

            <nav class="top-nav">
                <span class="active-tab">Register</span>
            </nav>

            <% if (!registered) { %>

                <div class="form-content">

                    <h2>Create Account</h2>

                    <p class="subtitle">
                        Enter your details to register
                    </p>

                    <% if (error) { %>
                        <p class="error"><%= error %></p>
                    <% } %>

                    <form action="/register" method="POST">

                        <label for="name">FULL NAME</label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter Your Full Name"
                            value="<%= name %>"
                            required
                        >

                        <label for="email">EMAIL</label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter Your Email"
                            value="<%= email %>"
                            required
                        >

                        <label class="terms" for="terms">
                            <input
                                type="checkbox"
                                id="terms"
                                name="terms"
                                value="yes"
                                required
                            >

                            <span>
                                I agree to the
                                <a href="#terms">Terms of Service</a>
                            </span>
                        </label>

                        <button type="submit">
                            Sign Up
                        </button>

                    </form>

                </div>

            <% } else { %>

                <div class="form-content success-content">

                    <div class="right-success-icon">&#10003;</div>

                    <h2>You're Registered!</h2>

                    <p class="subtitle">
                        Your information was submitted successfully.
                    </p>

                    <a class="button-link" href="/">
                        Register Another User
                    </a>

                </div>

            <% } %>

        </section>

    </main>

</body>
</html>
